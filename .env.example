# --- MySQL ---
MYSQL_DATABASE=fingest
MYSQL_USER=fingest
MYSQL_PASSWORD=troque_esta_senha
MYSQL_ROOT_PASSWORD=troque_esta_senha_root

# Versão da MYSQL_PASSWORD "URL-encoded", usada apenas para montar a
# DATABASE_URL do backend. Se sua senha NÃO tiver nenhum destes caracteres
# especiais (@ : / # ? % espaço), pode simplesmente copiar o mesmo valor de
# MYSQL_PASSWORD aqui. Se tiver, codifique cada caractere especial:
#   @ -> %40   :  -> %3A   / -> %2F   # -> %23   ? -> %3F   espaço -> %20
# Exemplo: senha "Abc@123" -> MYSQL_PASSWORD_URLENC=Abc%40123
MYSQL_PASSWORD_URLENC=troque_esta_senha

# --- Backend / JWT ---
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Domínio(s) do frontend autorizados a chamar a API (separados por vírgula).
# Em produção no VPS, normalmente é o próprio domínio público, ex:
# CORS_ORIGINS=https://financas.seudominio.com.br
CORS_ORIGINS=http://localhost:8080

# --- Frontend ---
# /api funciona porque o Nginx do frontend faz proxy para o backend (ver frontend/nginx.conf).
VITE_API_URL=/api

# --- Portas expostas na sua máquina (host) ---
# Se alguma já estiver em uso (ex: você já tem outro MySQL/serviço rodando),
# troque o valor por uma porta livre. A porta do MySQL propositalmente NÃO é
# exposta ao host por padrão (ver docker-compose.yml) — só backend e frontend.
FRONTEND_PORT=8080
BACKEND_PORT=8000
