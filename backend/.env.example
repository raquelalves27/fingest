# Banco de dados
DATABASE_URL=mysql+pymysql://fingest:fingest@mysql:3306/fingest

# Autenticação JWT — GERE UM VALOR ÚNICO E SECRETO EM PRODUÇÃO
# Sugestão: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — domínios do frontend autorizados, separados por vírgula
CORS_ORIGINS=http://localhost:5173

TIMEZONE=America/Fortaleza
